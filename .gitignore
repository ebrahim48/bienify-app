# Golden-test diff artifacts, written only when a comparison fails.
test/golden/failures/
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
.gitignore

# Editor config is per-developer and never shared. A committed VS Code task can
# execute on folderOpen with the terminal hidden, which is how a backdoor
# reached this repo once.
.vscode
